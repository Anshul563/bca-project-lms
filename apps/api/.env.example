# ---- Core ----
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/lms

# ---- CORS / URLs ----
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# ---- Auth / JWT ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-min-32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- Rate limiting (requests per 15-minute window) ----
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20

# ---- File storage ----
# local | cloudinary
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_PUBLIC_URL_PREFIX=/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP (password reset / verification emails) ----
# In development emails are logged to the console unless SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LMS <no-reply@lms.local>"
